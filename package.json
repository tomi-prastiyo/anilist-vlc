{
  "name": "anilist-vlc",
  "version": "1.1.0",
  "description": "Sync VLC and Web Anime playback to AniList & Discord",
  "main": "./dist/presentation/electron/main.js",
  "scripts": {
    "start": "ts-node src/main/index.ts",
    "dev": "ts-node-dev --respawn --transpile-only src/main/index.ts",
    "build:ui": "npm run build --prefix ui",
    "build:backend": "tsc",
    "build": "npm run build:ui && npm run build:backend",
    "electron:dev": "npm run build:backend && concurrently \"npm run dev --prefix ui\" \"wait-on tcp:5173 && cross-env NODE_ENV=development electron .\"",
    "electron:build": "npm run build && electron-builder"
  },
  "author": "PdBear",
  "license": "ISC",
  "dependencies": {
    "@types/discord-rpc": "^4.0.8",
    "@types/opn": "^5.5.0",
    "@xhayper/discord-rpc": "^1.3.0",
    "axios": "^1.8.4",
    "conf": "^15.1.0",
    "dotenv": "^16.4.5",
    "open": "^8.4.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4",
    "winston": "^3.19.0",
    "xml-js": "^1.6.11"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9.8.0",
    "tsconfig-paths": "^4.2.0",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "com.pdbear.anilistvlc",
    "productName": "AniList VLC Sync",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png"
    },
    "files": [
      "dist/**/*",
      "ui/dist/**/*",
      "package.json"
    ]
  }
}
